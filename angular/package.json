{
  "name": "online-store",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:shell",
    "start:shell": "ng serve shell",
    "start:catalog": "ng serve catalog",
    "start:cart": "ng serve cart",
    "start:checkout": "ng serve checkout",
    "start:recipe-box": "ng serve recipe-box",
    "start:my-store": "ng serve my-store",
    "start:all": "concurrently -k -n shell,catalog,cart,checkout,recipe-box,my-store -c cyan,magenta,yellow,green,blue,purple \"npm:start:shell\" \"npm:start:catalog\" \"npm:start:cart\" \"npm:start:checkout\" \"npm:start:recipe-box\" \"npm:start:my-store\"",
    "build": "ng build shell",
    "build:all": "ng build shared-auth && ng build shared-cart && ng build shared-data-access && ng build shared-ui && ng build catalog && ng build cart && ng build checkout && ng build recipe-box && ng build shell",
    "test": "ng test",
    "watch": "ng build shell --watch --configuration development"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@ngrx/signals": "^21.1.1",
    "es-module-shims": "^2.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^22.0.6",
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@softarc/native-federation-orchestrator": "^4.2.2",
    "concurrently": "^9.2.4",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
